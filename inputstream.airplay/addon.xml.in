<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="inputstream.airplay"
  version="0.1.1"
  name="AirPlay Receiver"
  provider-name="popcornmix">
  <requires>@ADDON_DEPENDS@</requires>
  <extension
    point="kodi.inputstream"
    name="airplay"
    protocols="airplay"
    extension=""
    tags="true"
    library_@PLATFORM@="@LIBRARY_FILENAME@"/>
  <extension
    point="xbmc.service"
    library="default.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/popcornmix/inputstream.airplay</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en_GB">Mirror an iPhone or iPad screen to Kodi</summary>
    <description lang="en_GB">Receives AirPlay screen mirroring, video streamed from apps, and audio, and plays them through Kodi's own pipeline, so hardware decoding and the normal renderer are used.

Video protected by DRM cannot be received: the sender blanks it before it leaves the phone.</description>
  </extension>
</addon>
